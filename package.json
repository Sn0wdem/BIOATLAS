{
  "name": "bioatlas",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "BioAtlas — Plataforma Global de Biodiversidade e Paleontologia",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:client": "esbuild src/client/firebaseClient.ts --bundle --format=iife --minify --outfile=public/firebase-bundle.js",
    "build": "npm run build:client && tsc --noEmit",
    "lint": "tsc --noEmit && eslint firestore.rules"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "express": "^5.1.0",
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
